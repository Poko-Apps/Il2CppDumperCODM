<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Il2CppDumper.Mobile</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <ApplicationTitle>Il2CppDumper</ApplicationTitle>
    <ApplicationId>com.local.il2cppdumper</ApplicationId>
    <ApplicationDisplayVersion>1.0.47</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- Produce a plain .apk (not .aab) so it can be sideloaded -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <NoWarn>$(NoWarn);CA1416;CS0168;CS0219</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep reflection-heavy code (Mono.Cecil, System.Text.Json) intact -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <!-- Reuse the original dumper sources without moving them.
       Windows-only files (dialogs, console Program) are excluded and replaced here. -->
  <ItemGroup>
    <Compile Include="..\Il2CppDumper\**\*.cs"
             Exclude="..\Il2CppDumper\Program.cs;..\Il2CppDumper\Resource1.Designer.cs;..\Il2CppDumper\Utils\FileDialogNative.cs;..\Il2CppDumper\Utils\OpenFileDialog.cs;..\Il2CppDumper\obj\**;..\Il2CppDumper\bin\**"
             LinkBase="Core" />
    <EmbeddedResource Include="..\Il2CppDumper\Libraries\Il2CppDummyDll.dll"
                      LogicalName="Il2CppDummyDll.dll"
                      Link="Core\Libraries\Il2CppDummyDll.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>

</Project>
